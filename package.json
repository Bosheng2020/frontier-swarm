{
  "name": "frontier-swarm",
  "version": "0.1.1",
  "description": "Typed, durable, eval-oriented multi-agent orchestration on Vercel eve with parallel specialists and independent review.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bosheng2020/frontier-swarm.git"
  },
  "homepage": "https://github.com/Bosheng2020/frontier-swarm#readme",
  "bugs": "https://github.com/Bosheng2020/frontier-swarm/issues",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "check": "pnpm typecheck && pnpm test && pnpm exec eve info --json && pnpm build",
    "demo": "node scripts/demo.ts",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "eval": "eve eval",
    "start": "eve start",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@vercel/connect": "2.5.2",
    "ai": "7.0.137",
    "eve": "0.81.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "just-bash": "3.1.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "keywords": [
    "agents",
    "multi-agent",
    "multi-agent-systems",
    "orchestration",
    "agent-orchestration",
    "agentic-ai",
    "llm-agents",
    "eve",
    "evals",
    "llm-evaluation",
    "ai-safety",
    "typescript",
    "durable-workflows"
  ]
}
